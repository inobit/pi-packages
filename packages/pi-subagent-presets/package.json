{
  "name": "@inobit/pi-subagent-presets",
  "version": "0.2.1",
  "description": "Batch-configure the model and thinking level of pi-subagents agents per project, plus the main agent defaults, and export the result as a reusable global profile blueprint.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "src",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit -p tsconfig.json",
    "pack:check": "pnpm pack --pack-destination /tmp"
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "pi-coding-agent",
    "coding-agent",
    "subagents",
    "presets",
    "model",
    "thinking"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/inobit/pi-packages.git",
    "directory": "packages/pi-subagent-presets"
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=0.87.1",
    "@earendil-works/pi-coding-agent": ">=0.87.1",
    "@earendil-works/pi-tui": ">=0.87.1",
    "pi-subagents": "*"
  },
  "peerDependenciesMeta": {
    "pi-subagents": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "catalog:",
    "@earendil-works/pi-coding-agent": "catalog:",
    "@earendil-works/pi-tui": "catalog:",
    "@types/node": "catalog:",
    "typebox": "catalog:",
    "typescript": "catalog:",
    "vitest": "^4.1.8"
  }
}
